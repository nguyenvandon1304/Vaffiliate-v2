NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

CASHBACK_CLICK_HASH_SECRET=
SHOPEE_AFFILIATE_ACCOUNT_ID=

# Phase 20H.3f -- Unikorn Shopee Product Data API base URL.
# Server-only env var. Optional: when unset, the documented public
# endpoint (https://data.addlivetag.com/product-data/product-data.php)
# is used. Do NOT prefix with NEXT_PUBLIC_: the URL must remain a
# server-only value to prevent leaking it to the client bundle.
SHOPEE_PRODUCT_DATA_API_BASE_URL=

# Phase 20K isolated database test safety.
# Configure values manually. Never commit project refs or connection strings.
# These variables authorize only an isolated test target and never authorize
# use of the incident-frozen project.
PHASE20K_TARGET_PROJECT_REF_SHA256=
PHASE20K_DAMAGED_PROJECT_REF_SHA256=
# Must equal PHASE20K_ISOLATED_TARGET_APPROVED exactly.
PHASE20K_ISOLATED_TARGET_ACK=
